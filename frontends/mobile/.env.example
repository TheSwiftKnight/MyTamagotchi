# ForkWorld backend
# 主后端为仓库根目录 backend/ 的 FastAPI（uvicorn app.main:app --port 8000），
# 提供 agents / plaza / skills / pets / world 全量 API + SQLite 持久化。
# WORLD_PORT 仅用于旧版 node demo server（server/index.mjs），已被 FastAPI 取代。
WORLD_PORT=8787
WORLD_TICK_INTERVAL_MS=12000

# Local deterministic narration is the safe default.
WORLD_LLM_ENABLED=false

# Optional OpenAI-compatible provider. The backend also recognizes
# DASHSCOPE_API_KEY + QWEN_MODEL, DEEPSEEK_API_KEY, or GMI_API_KEY + GMI_MODEL.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4.1-mini
LLM_TIMEOUT_MS=18000

# Frontend override, if the backend is hosted elsewhere.
# 默认指向 FastAPI 主后端（backend/，端口 8000）。
VITE_WORLD_API_URL=http://127.0.0.1:8000/api

# Injective EVM Testnet (public configuration only; wallet keys never belong here)
VITE_INJECTIVE_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
VITE_INJECTIVE_MARKET_ADDRESS=0xb9ccef65daa36db583c20556b4f9e91c6c43b0b4
VITE_INJECTIVE_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
VITE_SUPERVISED_TRAINING_API_URL=http://127.0.0.1:4000

# Cyber-pet image pipeline. Both stages use the GMI console request queue:
# photo -> gpt-image-2-edit solid-color illustration -> Bria transparent PNG.
# You can also point WORLD_ENV_FILE at an existing trusted .env containing
# GMI_API_KEY instead of copying the secret into this project.
GMI_API_KEY=
GMI_CONSOLE_BASE=https://console.gmicloud.ai/api/v1/ie/requestqueue/apikey
GMI_PET_IMAGE_MODEL=gpt-image-2-edit
GMI_REMOVE_BG_MODEL=bria-image-remove-background
